# Entorno de DESARROLLO local (infra/docker-compose.dev.yml). Copia a infra/.env.dev y cambia los valores.
# Nada de esto es de producción: son valores locales que solo sirven en tu máquina.
APP_ENV=development
POSTGRES_PASSWORD=cambia-esto-local
AUTHENTICATOR_PASSWORD=cambia-esto-local
# Debe tener 32 caracteres o más. El MISMO secreto lo usan PostgREST, GoTrue y quien firma las llaves.
JWT_SECRET=cambia-esto-un-secreto-local-de-32-caracteres-o-mas
# Las llaves anon y service_role son JWT firmados con JWT_SECRET (rol anon / rol service_role). Se generan con infra/scripts/make-keys.mjs.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
