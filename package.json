{
  "name": "avocado-studio",
  "private": true,
  "packageManager": "pnpm@9.3.0",
  "scripts": {
    "postinstall": "pnpm --filter @avocado/schemas build",
    "dev": "concurrently \"pnpm --filter avocado dev\" \"pnpm --filter community dev\" \"pnpm --filter backend dev\"",
    "dev:avocado": "pnpm --filter avocado dev",
    "dev:community": "pnpm --filter community dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter backend build",
    "build:avocado": "pnpm --filter avocado build",
    "build:community": "pnpm --filter community build",
    "build:backend": "pnpm --filter backend build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@supabase/supabase-js": "2.49.4",
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.5"
  }
}
